{
  "name": "appgraph",
  "version": "0.1.0",
  "description": "Static map of your app's screens — routes, component trees, API calls and selectors — as YAML for AI agents and HTML for humans",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "appgraph": "dist/cli/bin.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "assets": "tsx scripts/generate-assets.ts",
    "assets:ensure": "tsx scripts/generate-assets.ts --if-missing",
    "build": "pnpm run assets && tsup",
    "dev": "pnpm run assets && tsup --watch",
    "start": "node dist/cli/bin.js",
    "type-check": "pnpm run assets:ensure && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.ui.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm run assets:ensure && vitest run --bail=5",
    "test:watch": "pnpm run assets:ensure && vitest",
    "ui:build": "vite build -c report-ui/vite.config.ts",
    "e2e": "pnpm run assets && playwright test",
    "prepublishOnly": "pnpm build",
    "release": "doryski-release"
  },
  "keywords": [
    "react",
    "react-router",
    "nextjs",
    "static-analysis",
    "component-graph",
    "routes",
    "sitemap",
    "ai-agents",
    "codemap",
    "cli",
    "typescript"
  ],
  "author": "Dominik Rycharski (https://github.com/doryski)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Doryski/appgraph.git"
  },
  "bugs": {
    "url": "https://github.com/Doryski/appgraph/issues"
  },
  "homepage": "https://github.com/Doryski/appgraph#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "peerDependencies": {
    "@angular/compiler": ">=14.0.0",
    "typescript": ">=5.0.0 <7.0.0",
    "vue": ">=3.4.0 <4.0.0"
  },
  "peerDependenciesMeta": {
    "@angular/compiler": {
      "optional": true
    },
    "typescript": {
      "optional": false
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/compiler": "^22.2.1",
    "@axe-core/playwright": "^4.13.0",
    "@base-ui/react": "^1.8.0",
    "@doryski/release": "^1.1.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-hotkeys": "0.12.1",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.13",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.1",
    "lucide-react": "^1.50.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.2.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.11",
    "vue": "^3.5.43"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@>=4.0.0 <5.0.12": "5.0.12",
      "nanoid@<3.3.18": "3.3.18",
      "esbuild@>=0.27.3 <0.28.1": "0.28.1"
    }
  }
}
