# V1 n8n-io/n8n packages/frontend/editor-ui, commit 944afe5c889f130ac07c1831dd88fa7c7103a5c1
# Hand-derived from src/app/router.ts:175-1188 (routes, passed to createRouter at src/app/router.ts:1203-1212 via routes.map(withCanvasReadOnlyMeta))
# plus the spread ...projectsRoutes (src/app/router.ts:1158) from src/features/collaboration/projects/projects.routes.ts:127-252 (commonChildRoutes :36-88).
# Rule: every route record with a path is one URL, including redirect-only records (e.g. /workflow :520-521, /settings :619-622, /projects :129-134).
# Child paths join their parent; a parent and its '' child share one URL. Regex params keep their name (:entityType(credential|workflow) -> :entityType).
# /:pathMatch(.*)* (:1172) is the catch-all "*". Trailing slash dropped (/templates/ :276).
# Excluded: routes registered at runtime via router.addRoute from module descriptors (src/app/moduleInitializer/moduleInitializer.ts:177-181).
