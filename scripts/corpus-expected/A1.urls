# A1 Chocobozzz/PeerTube client, commit faa76bad2c1969a088ef1df38dc666dfe7259b5c
# Hand-derived from src/app/app.routes.ts:10-254 (default export, loadChildren targets nested under their path) and the lazy route files:
# +admin/routes.ts:80-161 (commonConfig :30-58; moderation/moderation.routes.ts:17-174, overview/overview.routes.ts:12-132, config/config.routes.ts:64-188,
# follows/follows.routes.ts:8-54, system/system.routes.ts:9-55, system/runners/runners.routes.ts:8-53, plugins/plugins.routes.ts:8-50),
# +my-account/routes.ts:21-200, +my-library/routes.ts:34-298 (+my-video-channels/routes.ts:47-88, +my-video-channels/edit/video-channel-edit.routes.ts:7-49),
# +signup/+verify-account/routes.ts:6-31, +accounts/routes.ts:12-56, +video-channels/routes.ts:11-44, shared/shared-plugin-pages/routes.ts:4-12,
# +about/routes.ts:10-55 (about-instance/about-instance.routes.ts:10-63), +signup/+register/routes.ts:6-21, +reset-password/routes.ts:4-14,
# +login/routes.ts:5-19, +search/routes.ts:10-53, +videos-publish-manage/+video-manage/routes.ts:15-37, +video-publish/routes.ts:19-61
# (shared-manage/routes.ts:12-53), +video-watch/routes.ts:17-50, +remote-interaction/routes.ts:7-22, +error-page/routes.ts:4-14 (under '**', app.routes.ts:251-254).
# Rule: one URL per route with component, loadComponent, redirectTo (string or function; the route's own path is the URL) or a '' child.
# Child paths join their parent; a parent and its '' child share one URL. '**' is the catch-all "*". canMatch siblings sharing a path count once.
# Componentless prefixes (e.g. verify-account '' :8, video-watch '' :19, my-account 'p' :186) and component parents without a '' child
# (+search/routes.ts:12 SearchComponent, +admin '' canMatch parents :87-111, +my-library MyVideoSpace/MyLibrary '' parents :263-297) are not URLs themselves.
# Function redirects counted: +admin/routes.ts:113-135 (/admin/config|follows|system|plugins), overview/overview.routes.ts:13-29 (/admin/comments|videos|users).
# Excluded: the two matcher routes and their subtrees, app.routes.ts:180-202 (home|videos -> +home/routes.ts, +video-list/routes.ts) and :215-233 (@username);
# the locale for...of routes, app.routes.ts:244-249; named-outlet routes (none present).
# Count: 180 URLs.
