# A4 thingsboard/thingsboard ui-ngx, commit 0439df09f31b0e8101b9f0a6be556c087d86818d
# Hand-derived (paths under src/app/) from app-routing.module.ts:6-19 (forRoot: '' -> home) and the NgModule graph of AppModule (app.module.ts:52-75), walked imports then exports:
# PageNotFoundRoutingModule app.module.ts:38-49 ('**'), modules/setup/setup-routing.module.ts:8-20, modules/login/login-routing.module.ts:32-130,
# modules/signup/signup-routing.module.ts:13-56, modules/empty-page/empty-page-routing.module.ts:7-16, modules/action/action-routing.module.ts:9-33,
# modules/dashboard/dashboard-routing.module.ts:9-21 -> loadChildren modules/dashboard/dashboard-pages.routing.module.ts:44-83,
# modules/home/home-routing.module.ts:12-23 ('' HomeComponent, loadChildren HomePagesModule) -> modules/home/pages/home-pages.module.ts:56-111 (exports only);
# every exported page module's forChild routes mount at '/' — main files: pages/admin/admin-routing.module.ts:137-615, pages/customer/customer-routing.module.ts:29-290,
# pages/edge/edge-routing.module.ts:75-666, pages/agent/agent-routing.module.ts:69-455, pages/device/device-routing.module.ts:23-195, pages/asset/asset-routing.module.ts:23-195,
# pages/entity-view/entity-view-routing.module.ts:24-196, pages/dashboard/dashboard-routing.module.ts:56-218, pages/user/user-routing.module.ts:20-155,
# pages/group/entity-group-routing.module.ts:46-277, pages/entities/entities-routing.module.ts:12-40, pages/iot-hub/iot-hub-routing.module.ts:17-210,
# pages/notification/notification-routing.module.ts:16-121, pages/account/account-routing.module.ts:16-52, pages/home-links/home-links-routing.module.ts:138-159 (+ ~40 smaller routing files).
# Factories expanded with literal args: entitiesRoute(true), edgesRoute(true), usersRoute(true), dashboardsRoute(true), customersRoute(true) (if (root) branches kept);
# customerChildrenRoutes() (customer-routing.module.ts:50-121, no-arg customersRoute/entitiesRoute/dashboardsRoute/usersRoute/edgesRoute + agentsRoute) under /customers/all, /customers/groups/:id, /customers/shared/:id.
# Rule: one URL per route with component, loadComponent, redirectTo (string or function) or a '' child; child paths join their parent; '**' is "*".
# A componentless '' child carrying data.redirectTo is emitted as a redirect rule (GA7), not a screen: its parent URL is EXCLUDED here, matching corpus.ts isRuleRedirect (rule redirects are not URLs).
# Componentless prefixes and component parents without a '' child (e.g. home-routing.module.ts:12 HomeComponent) are not URLs themselves.
# Excluded: entity-group-routing.module.ts:47-91 guard-only redirects ({children: [], canActivate}, no component/redirectTo/'' child) for entities/devices|assets|entityViews/:entityId,
# customers/:entityId, edgeManagement/edges/:entityId; matcher and named-outlet routes (none present). agent-routing.module.ts:70 ':agentId' tabs parents equal ':entityId' (:163,:271) by shape and are listed once.
# Count: 637 URLs.
# 2026-10-03: /edgeManagement/templates/ruleChain/import corrected to .../ruleChains/ruleChain/import (child of ruleChains, edge-routing.module.ts:443; app navigates there at rulechains-table-config.ts:260).
