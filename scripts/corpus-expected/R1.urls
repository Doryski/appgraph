# R1 makeplane/plane apps/web, commit c7a5afee6afd15f16038ebda1ec1489ebd8af67d
# Hand-derived from app/routes/core.ts (coreRoutes: 67 route(), 43 layout(), 1 index() calls) merged with app/routes/extended.ts (empty array, mergeRoutes is a union)
# under the pathless layout(./layout.tsx) shell plus the top-level route("*", ./not-found.tsx) in app/routes.ts.
# Rule: layout() adds no segment; index() takes its parent's URL; route() paths are relative to the nearest route() ancestor (no absolute paths used); every route() is one URL,
# including ones that only have route() children (e.g. /:workspaceSlug). Splat routes (settings/*, profile/*) keep their "*"; the top-level catch-all is "*".
