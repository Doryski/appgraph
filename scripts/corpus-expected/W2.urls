# W2 apache/superset superset-frontend, commit bc3698b5d64b973d249d59f584a8dc3c48c83263
# Hand-derived from the routes array in src/views/routes.tsx (every path: RoutePaths.X, resolved via src/views/routePaths.ts, plus the literal '/archived/' push),
# including the conditional routes.push entries (feature flags, admin, auth registration), which are included unconditionally.
# Trailing slashes are dropped (/welcome/ -> /welcome); params keep their :name (/dashboard/:idOrSlug).
# / is included: <Redirect from="/" to="/welcome/" exact/> (src/views/App.tsx:123) is a route-declared redirect source, counted as a URL (as for R2 /auth/github).
